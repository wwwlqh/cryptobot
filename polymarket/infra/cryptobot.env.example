# cryptobot environment template.
#
# install_remote.sh copies this to /etc/cryptobot.env on the first install
# (chmod 0640, root:<service user>). After that the file is kept, except for
# the settings install_remote.sh pins on every deploy (layout, strategy, risk,
# execution and market data); change those in install_remote.sh, not here.
#
# Settings are read once at boot: edit, then `sudo systemctl restart cryptobot`.
# Commented-out lines show the code default.

# ---- Layout -----------------------------------------------------------------
CRYPTOBOT_ROOT=/home/ec2-user/cryptobot
PYTHONPATH=/home/ec2-user/cryptobot/src
PYTHONWARNINGS=ignore::UserWarning:sklearn.utils.parallel
CRYPTOBOT_DB_PATH=/home/ec2-user/cryptobot/data/cryptobot.db
# Strategy config. The exposure cap and drawdown halt below must equal its
# concurrent_exposure_cap_fraction / max_drawdown_halt_frac or boot fails.
CRYPTOBOT_V6_CONFIG=/home/ec2-user/cryptobot/runtime/config/twap_symmetric_live.json
CRYPTOBOT_DASHBOARD_DIR=/home/ec2-user/cryptobot/dashboard

# ---- Strategy ---------------------------------------------------------------
CRYPTOBOT_SUBMINUTE_ENABLED=1
CRYPTOBOT_COINS=BTC,ETH,SOL,XRP
CRYPTOBOT_INTERVAL_5M_ENABLED=1
# One order per market; no top-ups.
CRYPTOBOT_ENABLE_TOPUPS=0
# Emergency stop for all sub-minute orders (no redeploy needed, just restart).
# CRYPTOBOT_SUBMINUTE_KILL=0

# ---- Sizing and risk --------------------------------------------------------
# Stake = equity x base fraction x drawdown brake x 1/sqrt(same-minute bets),
# at least MIN_BET_USD. Brake floor 1.0 turns the brake off.
CRYPTOBOT_V2_BASE_FRAC_15M=0.010
CRYPTOBOT_V2_BASE_FRAC_5M=0.010
CRYPTOBOT_V2_BRAKE_SCALE=0.60
CRYPTOBOT_V2_BRAKE_FLOOR=1.0
CRYPTOBOT_V2_CONC_DOWNWEIGHT=1
CRYPTOBOT_MIN_BET_USD=1.0
CRYPTOBOT_SHARED_EXPOSURE_CAP=1.0
# Trading halts at this drawdown from peak equity.
CRYPTOBOT_MAX_DD_HALT_FRAC=0.40

# ---- Execution --------------------------------------------------------------
# A rejected FAK leaves the market open; later qualifying seconds retry at
# their own price plus the pad.
CRYPTOBOT_V2_REJECT_RETRY=1
CRYPTOBOT_V2_RETRY_REPRICE=1
CRYPTOBOT_V2_FAK_PAD=0.01
CRYPTOBOT_PHASE_B_PARALLEL_POST=1
# Sub-second entry scans (250ms sweep plus WebSocket book-update trigger).
# CRYPTOBOT_FAST_TRIGGER_ENABLED=1
# CRYPTOBOT_FAST_TRIGGER_MS=250
# CRYPTOBOT_FAST_TRIGGER_EVENT_ENABLED=1

# ---- Fill-rate breaker ------------------------------------------------------
# Disarmed: a minimum fill rate of 0 and a 999x loss limit never trip. To arm
# it, set RESET to a recent UTC time and MIN_FILL_RATE to e.g. 0.2.
CRYPTOBOT_SUBMINUTE_BREAKER_RESET=2026-07-08T13:45:00Z
CRYPTOBOT_SUBMINUTE_BREAKER_MIN_FILL_RATE=0.0
CRYPTOBOT_SUBMINUTE_BREAKER_EV_MAX_LOSS_FRAC=999

# ---- Market data ------------------------------------------------------------
CRYPTOBOT_TWAP_RTDS_URL=wss://ws-live-data.polymarket.com
CRYPTOBOT_SPOT_SOURCE=binance
CRYPTOBOT_SPOT_FETCH_INTERVAL_SECONDS=1
CRYPTOBOT_SPOT_USE_1S_KLINES=1
CRYPTOBOT_SPOT_STALENESS_S=5
CRYPTOBOT_BINANCE_BASE_URL=https://data-api.binance.vision
CRYPTOBOT_SPOT_PREFETCH_LEAD_MS=450
CRYPTOBOT_BOOK_PREFETCH_ENABLED=true
CRYPTOBOT_BOOK_PREFETCH_LEAD_MS=400
# WebSocket book mirror, read before REST. Set ENABLED=0 to use REST only.
CRYPTOBOT_BOOK_WS_ENABLED=1
CRYPTOBOT_BOOK_WS_SHADOW=0
CRYPTOBOT_BOOK_WS_MAX_AGE_MS=600000
# CRYPTOBOT_BOOK_WS_WATCHDOG_ENABLED=true

# ---- Housekeeping -----------------------------------------------------------
# CRYPTOBOT_SWEEP_MINUTES=5
# CRYPTOBOT_SIGNALS_RETENTION_DAYS=7
# CRYPTOBOT_MISS_FORENSICS_ENABLED=1

# ---- Accounting -------------------------------------------------------------
# INITIAL_BANKROLL is the account balance at WALLET_START_AT (UTC). After a
# reset (RESET_RECORDS=1 on deploy), set INITIAL_BANKROLL to the balance at the
# new cutover. Older ledger rows stay in the database but leave the record.
CRYPTOBOT_INITIAL_BANKROLL=100
# CRYPTOBOT_WALLET_START_AT=
# Default mode for wallets on the first boot only; afterwards the per-wallet
# mode in the database is authoritative (dashboard or cbot-set-wallet-mode).
DRY_RUN=true

# ---- Dashboard --------------------------------------------------------------
# Binds to loopback; reach it through an SSH tunnel:
#   ssh -L 8800:127.0.0.1:8800 -i <key.pem> ec2-user@<host>
# A non-loopback bind also needs CRYPTOBOT_ALLOW_REMOTE_DASHBOARD=1 and
# CRYPTOBOT_DASHBOARD_TLS_TERMINATED=1 (a TLS reverse proxy in front).
CRYPTOBOT_DASHBOARD_HOST=127.0.0.1
CRYPTOBOT_DASHBOARD_PORT=8800
# CRYPTOBOT_ALLOW_REMOTE_DASHBOARD=0
# CRYPTOBOT_DASHBOARD_TLS_TERMINATED=0
# Login for the dashboard's controls. Use a long random password (32+
# characters); boot fails with an empty one unless auth is explicitly disabled
# (CRYPTOBOT_DASHBOARD_AUTH_DISABLED=1, loopback only).
CRYPTOBOT_DASHBOARD_USER=admin
CRYPTOBOT_DASHBOARD_PASS=

# ---- Polymarket credentials (required for LIVE) -----------------------------
# Generate with `python -m cryptobot_polymarket.derive_creds` or the Polymarket
# UI. Reading books and prices needs none of these.
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=

# Wallet type: 0=EOA, 1=POLY_PROXY, 2=POLY_GNOSIS_SAFE, 3=POLY_1271 (deposit
# wallet, the usual case). If Polymarket's Deposit page shows a different
# address from your signer, use 3 and set POLY_FUNDER to that deposit address;
# if it is the same address, use 0. Type 3 without POLY_FUNDER fails boot.
POLY_SIGNATURE_TYPE=3
POLY_FUNDER=
# The only address withdrawals may be sent to.
POLY_RETURN_WALLET=

# Relayer (transfers).
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Polygon RPC for on-chain balance checks. A dedicated authenticated endpoint
# is better than the public default for live trading.
POLYGON_RPC_URL=https://polygon-rpc.com

# ---- Live readiness ---------------------------------------------------------
LIVE_REQUIRE_DEPOSIT_WALLET=true
LIVE_ONCHAIN_VERIFY_ENABLED=true
LIVE_BALANCE_TOLERANCE_USD=0.25
WALLET_SNAPSHOT_FRESHNESS_TTL_S=900
WALLET_SNAPSHOT_INTERVAL_MINUTES=10

# ---- Telegram alerts (optional) ---------------------------------------------
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
