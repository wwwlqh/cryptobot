[Unit]
Description=cryptobot failure Telegram alert (fired by cryptobot.service OnFailure=)

[Service]
Type=oneshot
EnvironmentFile=/etc/cryptobot.env
# Best-effort: silently a no-op when the Telegram env is unset. The scanner
# process cannot alert on its own crash, so this rides systemd's OnFailure=
# hook. -m 10 bounds the curl so a Telegram outage can't wedge the unit.
ExecStart=/bin/bash -c 'if [ -n "${NOTIFY_TELEGRAM_TOKEN:-}" ] && [ -n "${NOTIFY_TELEGRAM_CHAT_ID:-}" ]; then curl -sS -m 10 -X POST "https://api.telegram.org/bot${NOTIFY_TELEGRAM_TOKEN}/sendMessage" -d chat_id="${NOTIFY_TELEGRAM_CHAT_ID}" --data-urlencode text="[service_failure] cryptobot.service entered failed state on $(hostname) at $(date -u +%%FT%%TZ). Check: journalctl -u cryptobot -n 50"; fi'
