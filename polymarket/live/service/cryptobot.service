[Unit]
Description=cryptobot live scanner (Polymarket *-updown-* + Binance spot)
Documentation=https://github.com/wwwlqh/cryptobot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
# Telegram alert when the service lands in failed state (crash loop past the
# restart burst, or a non-restartable exit). The scanner cannot alert on its
# own death; this hook is the out-of-process backstop.
OnFailure=cryptobot-failure-alert.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/cryptobot
EnvironmentFile=/etc/cryptobot.env

# Python venv + project import path
ExecStart=/home/ec2-user/cryptobot/.venv/bin/python -m cryptobot

# Restart after a crash; a clean exit (SIGTERM at shutdown returns 0) is not
# restarted.
Restart=on-failure
RestartSec=5

# Logging — append (not overwrite) so journal + flat file both exist.
# journald captures stdout+stderr automatically; the flat file is for grep.
StandardOutput=append:/var/log/cryptobot/scanner.log
StandardError=append:/var/log/cryptobot/scanner.err

# Graceful shutdown — main.py installs a SIGTERM handler that drains the
# in-flight tick via scheduler.shutdown(wait=True) before closing the DB.
KillSignal=SIGTERM
TimeoutStopSec=30

# Memory limits for the 4 GB instance; leaves ~500 MB for the OS.
MemoryMax=3300M
MemoryHigh=2900M
LimitNOFILE=4096

# Filesystem hardening — bot only writes to data/, runtime/data and logs
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/cryptobot/data /home/ec2-user/cryptobot/runtime/data /var/log/cryptobot
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
