[Unit]
Description=Daily timer for cryptobot WAL checkpoint
Documentation=https://github.com/wwwlqh/cryptobot

[Timer]
# 04:00 UTC daily, a quiet hour for the markets, with up to 5 minutes of
# random delay. Persistent=true runs a missed firing at boot.
OnCalendar=*-*-* 04:00:00 UTC
RandomizedDelaySec=300
Persistent=true
Unit=cryptobot-wal-checkpoint.service

[Install]
WantedBy=timers.target
