[Unit]
Description=cryptobot WAL checkpoint (TRUNCATE) + audit prune + disk-free check
Documentation=https://github.com/wwwlqh/cryptobot
# Ordered after the bot if it is running. Do not add Requires=cryptobot.service:
# that would start a bot the operator deliberately stopped. The script itself
# skips its work when the bot is not active.
After=cryptobot.service

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/cryptobot
ExecStart=/home/ec2-user/cryptobot/deploy/cron.daily.sh
StandardOutput=journal
StandardError=journal

MemoryMax=200M
LimitNOFILE=512

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/cryptobot/data
PrivateTmp=true
NoNewPrivileges=true
