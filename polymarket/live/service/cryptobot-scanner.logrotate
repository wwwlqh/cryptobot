/var/log/cryptobot/scanner.log
/var/log/cryptobot/scanner.err
{
    # su is required: /var/log/cryptobot is group-writable, and logrotate
    # refuses to rotate under such a directory without being told which
    # user/group to rotate as (without it scanner.err grows unbounded).
    su ec2-user ec2-user
    daily
    rotate 90
    maxage 90
    maxsize 3G
    missingok
    notifempty
    compress
    copytruncate
}
