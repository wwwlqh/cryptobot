[Unit]
Description=cryptobot predict.fun DRY paper scanner (BTC/ETH, $100, own DB)
Documentation=https://github.com/your-org/cryptobot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
# Deliberately NO OnFailure=cryptobot-failure-alert.service — that alert says
# the LIVE bot died; a PAPER-bot crash must never page as a live-money event.

# SECOND scanner instance, PAPER ONLY. Fully isolated from the live Polymarket
# bot: its OWN SQLite file (data/predictfun_paper/ — the live process
# never opens it; entry latches / DD-brake / halt / operator state are all
# single-venue tables, so sharing data/cryptobot.db would corrupt live
# accounting AND live behavior), its OWN loopback dashboard port (8801), and a
# structurally-empty signing key (PREDICTFUN_PRIVATE_KEY= forced blank in the
# second env file => order_client=None => LIVE placement impossible).
#
# Env layering (systemd gotcha, `man systemd.exec`): EnvironmentFile= values
# override Environment= lines regardless of order, so the overrides live in a
# SECOND env file listed after the shared one — later file wins per-key. The
# shared /etc/cryptobot.env still supplies the API key, dashboard pass, models
# and every force-pinned strategy knob; /etc/cryptobot-predictfun.env (written
# by install_remote.sh, never git-tracked) overrides only the venue seam.
#
# Flag-gated like the recorders: install_remote.sh enables+starts this unit
# ONLY when CRYPTOBOT_PREDICTFUN_DRY_ENABLED=1 is pinned in /etc/cryptobot.env
# (default OFF). NOTE: unlike the recorder modules, main.py has no self-exit on
# the flag — the gate is unit-level only; a manual `systemctl start` runs it,
# harm bounded to DRY paper rows in its own DB.
#
# ⚠️ MEMORY: this loads the identical artifact stack as the live unit (the
# 614 MB checkpoint forest; live needs MemoryMax=3300M on the 3819 MB box). DO NOT arm on the current box — two full scanners OOM-risk the
# LIVE bot. Upsize the instance (>= 8 GB) first. MemoryMax here is set BELOW
# the live unit's so the OOM-killer prefers the paper bot.

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/cryptobot
EnvironmentFile=/etc/cryptobot.env
EnvironmentFile=/etc/cryptobot-predictfun.env

ExecStart=/home/ec2-user/cryptobot/.venv/bin/python -m cryptobot

Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/cryptobot/predictfun-scanner.log
StandardError=append:/var/log/cryptobot/predictfun-scanner.err

KillSignal=SIGTERM
TimeoutStopSec=30

# Below the live unit's 3300M/2900M — the OOM-killer must prefer this paper
# process over the real-money one.
MemoryMax=3000M
MemoryHigh=2600M
LimitNOFILE=4096

# Filesystem hardening TIGHTER than cryptobot.service (2026-07-21 safety
# audit): instead of the whole data/ tree, only this instance's OWN DB file +
# WAL sidecars are writable — the live bot's data/cryptobot.db (and everything
# else under data/) stays READ-ONLY in this unit's mount namespace, so a paper
# write to the live ledger is structurally impossible, not just configured
# away. install_remote.sh pre-creates the three files (systemd only
# bind-mounts paths that exist at unit start; the '-' prefix skips a missing
# path instead of failing the unit — the DB then can't be created on a
# read-only data/, which fails safe for a PAPER instance). SQLite's
# close-time WAL/-shm unlink failing on a bind-mounted file is benign
# (ignored; the sidecar is truncated/reused on the next open).
ProtectSystem=strict
ProtectHome=read-only
# Directory-level rw for THIS instance's DB dirs ONLY: SQLite WAL needs
# create/unlink in the DB's directory (file-level bind mounts broke WAL open,
# 2026-07-22); data/ itself — and the live Polymarket cryptobot.db in it —
# stays read-only here. predictfun_live is the REAL-MONEY variant's DB dir
# (installer live-mode branch, 2026-07-23); '-' skips whichever is absent.
ReadWritePaths=-/home/ec2-user/cryptobot/data/predictfun_paper
ReadWritePaths=-/home/ec2-user/cryptobot/data/predictfun_live
ReadWritePaths=/home/ec2-user/cryptobot/runtime/data /var/log/cryptobot
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
