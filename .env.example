# cryptobot configuration — copy to .env and fill in. .env is gitignored.
#
# This template is for cryptobot ONLY. Do NOT paste hightempbot's wallet,
# private key, or API creds here — the two bots run on different funders
# so they can be operated/halted independently.

# ─────────────────────────────────────────────────────────────────────────────
# BACKTEST DATA ONLY (not needed to run the live bot): pmdata.dev — real CLOB
# L2 order-book snapshots + Chainlink price context. Supplies the real-book
# yes/no prices for the decision table and the book-depth index. Get a key at
# pmdata.dev.
# Used by: polymarket/backtest/fetch/{pmdata_download,pmdata_raw_pull}.py and
#          polymarket/backtest/scripts/tick_download_last30.py (downloads), plus
#          polymarket/backtest/lib/forward_oos_regrade.py (settlement lookups).
# NOTE: the old polymarketdata.co paid feed (POLYMARKETDATA_API_KEY / polymarket.db)
#       is RETIRED — its fetcher was removed 2026-07-12; prices now come from
#       pmdata, and yes/no OUTCOMES from the keyless Gamma Chainlink resolution.
# ─────────────────────────────────────────────────────────────────────────────
PMDATA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Polymarket CLOB credentials (REQUIRED for any wallet flipped to LIVE)
# Generate via https://docs.polymarket.com/#authentication (sign-then-derive
# from your wallet's private key). All four values are needed to place orders;
# read-only book + price queries don't need any of them.
#
# Get fresh creds for THIS wallet — do NOT reuse hightempbot's creds.
# Same private key + different API key set is fine; cleaner to derive
# brand-new L2 creds with `python -m cryptobot_polymarket.derive_creds`
# once that CLI ships.
# ─────────────────────────────────────────────────────────────────────────────
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=        # cryptobot's wallet EOA private key for EIP-712 order signing

# ─────────────────────────────────────────────────────────────────────────────
# Polymarket V2 wallet topology — MetaMask users: keep reading
#
# Using MetaMask as your signer is independent of the signature type.
# What matters is WHERE THE FUNDS LIVE:
#
#   POLY_SIGNATURE_TYPE values:
#     0 = EOA              — funds at the MetaMask address itself
#                            (you deposited USDC directly to your MetaMask
#                            on Polygon; advanced on-chain trader path)
#     1 = POLY_PROXY       — legacy email/MagicLink proxy wallet (don't use)
#     2 = POLY_GNOSIS_SAFE — Safe wallet (rare)
#     3 = POLY_1271        — Polymarket-managed deposit wallet (~95% of users,
#                            including most MetaMask users — funds sit in a
#                            smart contract Polymarket auto-created for you;
#                            MetaMask just signs orders on its behalf)
#
# HOW TO PICK (open polymarket.com → connect MetaMask → check Deposit page):
#   - Deposit page shows a DIFFERENT address than your MetaMask account?
#       → SIG=3, POLY_FUNDER = that deposit address (NOT MetaMask)
#   - Deposit page shows the SAME address as your MetaMask account?
#       → SIG=0, POLY_FUNDER = your MetaMask address (or leave empty)
#
# When SIG=3, POLY_FUNDER is REQUIRED. Boot refuses otherwise.
# Fund this address before flipping any wallet to LIVE. The live config is a
# single shared-equity wallet group (group_live, cap $120.3838 = the full
# funded balance; sub-minute members are flag-stripped when disabled).
# Do NOT reuse hightempbot's funder address — fresh wallet for cryptobot.
# ─────────────────────────────────────────────────────────────────────────────
POLY_SIGNATURE_TYPE=3
POLY_FUNDER=             # 0x... cryptobot's Polymarket DEPOSIT wallet (not your MetaMask) when SIG=3
                         # 0x... your MetaMask address when SIG=0
POLY_RETURN_WALLET=      # 0x... your cold wallet for pUSD withdrawals (usually your MetaMask)

# ─────────────────────────────────────────────────────────────────────────────
# Polymarket relayer (used for transfer + redemption submissions)
# Default value matches Polymarket's official v2 relayer; only override if
# Polymarket publicly documents a region-specific endpoint.
# ─────────────────────────────────────────────────────────────────────────────
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS= # 0x... API key signer address (NOT the funder)

# ─────────────────────────────────────────────────────────────────────────────
# Polygon RPC for on-chain reconciliation (wallet balance, CTF positions)
# Default is the public free endpoint; if you have an Alchemy / Infura key
# put their URL here for higher rate limits.
# ─────────────────────────────────────────────────────────────────────────────
POLYGON_RPC_URL=https://polygon-rpc.com

# ─────────────────────────────────────────────────────────────────────────────
# Live readiness / wallet reconciliation TTLs (seconds / minutes)
# These match hightempbot's safe defaults; tune later only with cause.
# ─────────────────────────────────────────────────────────────────────────────
LIVE_REQUIRE_DEPOSIT_WALLET=true
LIVE_ONCHAIN_VERIFY_ENABLED=true
LIVE_BALANCE_TOLERANCE_USD=0.25
LIVE_READINESS_CACHE_TTL_S=120
WALLET_SNAPSHOT_FRESHNESS_TTL_S=900
WALLET_SNAPSHOT_INTERVAL_MINUTES=10
# ─────────────────────────────────────────────────────────────────────────────
# Application config (paper-trading defaults)
# CRYPTOBOT_INITIAL_BANKROLL defaults to $100. For a live-equity cutover,
# set it to the current CLOB pUSD balance and reset CRYPTOBOT_WALLET_START_AT
# so historical PnL is not added on top of the new wallet balance. Group caps
# come from the loaded portfolio JSON.
# DRY_RUN only sets the DEFAULT mode for fresh wallets on first boot.
# Once wallet_mode_state has rows, per-wallet mode is authoritative
# (toggle via dashboard or `python -m cryptobot.cli.set_wallet_mode`).
# ─────────────────────────────────────────────────────────────────────────────
CRYPTOBOT_INITIAL_BANKROLL=100
DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# LIVE STRATEGY: TWAP-symmetric trend (Polymarket production since 2026-08-12)
#
# These are the flags that define the live strategy. On the EC2 box
# polymarket/infra/install_remote.sh FORCE-PINS them on every deploy (they live in
# /etc/cryptobot.env, seeded once, then re-pinned) — the values below are the
# pinned production values, documented here for reference. Defaults live in
# polymarket/src/cryptobot/config.py; env overrides win.
# ─────────────────────────────────────────────────────────────────────────────

# Master flag. REQUIRED for step1last to load: the portfolio loader drops the
# checkpoint sub-minute sleeves (and their wallet group) when off, and the
# v2_step1last config is checkpoint-only, so with it off there is nothing to
# run. Default 0; pinned 1 on the box.
CRYPTOBOT_SUBMINUTE_ENABLED=1

# Runtime portfolio config. Unset, config._resolve_artifact takes the first
# path that EXISTS: runtime/config/ (the staged copy the box reads) ->
# backtest/optimize_runs/ (pre-restructure checkouts still have it) ->
# polymarket/live/config/ (its post-2026-07-28 home). The env var
# NAME is legacy ("V6") and deliberately unchanged — the deploy stages the
# current `twap_symmetric_live.json` source under this remote compatibility name.
# CRYPTOBOT_V6_CONFIG=/home/ec2-user/cryptobot/runtime/config/v2_step1last_live.json
# The TWAP scorer is Polymarket-only and requires exact 30s/60s Chainlink RTDS
# plus causal Binance opening TWAP anchors over the same windows. It abstains
# when either is missing. Keep it off locally unless the model bundle is present.
CRYPTOBOT_TWAP_SYMMETRIC_ENABLED=0
CRYPTOBOT_TWAP_RTDS_URL=wss://ws-live-data.polymarket.com

# One order per market resolution: top-ups off (part of the one-bet-per-window
# invariant). Default 1 (on); pinned 0 (off) on the box.
CRYPTOBOT_ENABLE_TOPUPS=0

# Scan universe. The current production contract is BTC+SOL.
CRYPTOBOT_COINS=BTC,SOL

# v2 equity-fraction sizing (execution/sizing_v2.py):
#   stake = equity * base_frac(interval) * brake(dd) * 1/sqrt(k), floored UP to
#   MIN_BET_USD (sub-$1 bets are placed at $1, never skipped).
#   brake = max(BRAKE_FLOOR, 1 - dd/BRAKE_SCALE); k = same-minute concurrency.
# Current TWAP production sizing is 2% on both intervals; the 30% shared-
# equity drawdown halt remains armed.
# The 0.30 hard halt (CRYPTOBOT_MAX_DD_HALT_FRAC) is the SOLE drawdown guard.
CRYPTOBOT_V2_BASE_FRAC_15M=0.020
CRYPTOBOT_V2_BASE_FRAC_5M=0.020
CRYPTOBOT_V2_BRAKE_SCALE=0.60
CRYPTOBOT_V2_BRAKE_FLOOR=1.0
CRYPTOBOT_V2_CONC_DOWNWEIGHT=1

# Reject-retry: on a LIVE FAK rejection, re-read the book ONCE and re-shoot iff
# the window is still open, the fresh ask is still in (0.65, 0.85], and
# pred_edge still clears the 0.03 gate. One retry max per (market, side) window;
# a filled retry consumes the window like a filled first attempt. Pinned on.
CRYPTOBOT_V2_REJECT_RETRY=1

# First-attempt-only (operator order 2026-07-29, DEFAULT ON): a venue
# no_liquidity reject of a non-top-up sub-minute attempt CONSUMES that side
# window — later qualifying seconds skip (skip_reason=first_attempt_consumed)
# instead of retrying, and the fast-requote never arms. Entry selection is
# unchanged (every qualifying second can still be the FIRST attempt). Evidence:
# retry fills -6.2c/bet vs -2.3c first-try; dip-refill cohort WR 52.2%
# (-33.7c/$1). Set to 0 to restore per-second retry semantics.
CRYPTOBOT_V2_FIRST_ATTEMPT_ONLY=1

# On-chain miss forensics (operator order 2026-07-30, DEFAULT ON). A 5-min
# scheduler job classifies every venue `no_liquidity` reject from the TRADE
# TAPE — FASTER_TAKER (a print inside the LEVEL BAND, i.e. from the ask we saw
# up to our limit +-0.5c, within the venue-match window: the quote was real and
# someone else took it), REPRICED_ONLY (prints exist but all outside that
# band), MAKER_CANCEL (no print at all) — and writes the verdict to
# `miss_forensics` for the Subminute tab. This is the question the
# ~1s post-reject book re-read CANNOT answer: "the ask is gone" reads the same
# whether it traded away or was pulled, which is how the "68% maker-cancel"
# inference got made and then refuted. Method: complement-token mint-match (an
# ask on T can print as a BUY of T or a SELL of its complement at 1-p) plus a
# settlement-lag correction (~+3s, re-calibrated from our own fills).
# Strictly off the decision path: reads subminute_fills/live_order_attempts,
# writes only miss_forensics, all exceptions swallowed with a WARN, and the
# per-run HTTP/RPC call counts are hard-capped (a venue outage leaves rows
# PENDING for the next fire). Polymarket-only — the job refuses to arm on the
# predict.fun venue. Needs POLY_FUNDER; POLYGON_RPC_URL is optional and only
# adds the rival maker's address to a FASTER_TAKER verdict.
# Kill switch: 0 registers no job at all.
# CRYPTOBOT_MISS_FORENSICS_ENABLED=1
# CRYPTOBOT_MISS_FORENSICS_SECONDS=300

# Fast-trigger entry path (operator order 2026-07-30, DEFAULT ON). What the
# forensic above measured: 84% of our misses were taken by a FASTER TAKER,
# median 1.0s before we arrived, ~5x our size, at exactly our quoted ask. The
# POST path is already at the venue floor (sign ~1ms, POST ~300ms of which 250ms
# is the taker delay every taker pays), so the only reclaimable latency is
# TRIGGER-TO-DECISION: the scanner samples once per second on a boundary-aligned
# tick, so an ask that becomes fillable mid-second waits ~500ms on average
# before we even look at it. Two extra trigger rungs close that gap, and BOTH
# converge on the tick's own single-cell evaluation (same scoring at the same
# integer offset_sec, same book resolver, same _commit_cell) — so band, gate,
# V2_EDGE_CAP, sizing/caps/DD-brake, one-per-window dedup, the WindowDecider's
# same-offset dedup, first-attempt-only and multifill all bind identically. A
# fast placement is stamped subminute_fills.trigger_src='fast_sweep'/'fast_event'
# ('tick' on every other row) so fast-vs-tick realized c/$ is separable.
#   * SWEEP rung — an APScheduler job every CRYPTOBOT_FAST_TRIGGER_MS. Outside a
#     qualifying offset window it returns after pure integer math over the
#     sleeves' offset sets, so the cadence is ~free ~90% of the time. Clamped to
#     >=100ms (the proven floor for a sub-second job on this box).
#   * EVENT rung — the WS book mirror fires an ask-side callback and a dedicated
#     coalescing worker re-evaluates within ~20ms of the push. Needs
#     CRYPTOBOT_BOOK_WS_ENABLED=1 and a mirror exposing the hook (Polymarket
#     does; predict.fun's market-keyed mirror does not yet, so PF runs the sweep
#     rung alone). Separately killable because it is the rung that touches the
#     venue's WS reader thread.
# Safety: a fast scan and the tick's per-cell commit are single-flighted through
# one process-wide lock — the tick takes it BLOCKING (never skipped), a fast rung
# takes it NON-BLOCKING and abandons the scan when contended. The fast rungs
# never spend a REST book call (cache/push only) and write NO rows unless
# something actually places or rejects.
# Kill switches: CRYPTOBOT_FAST_TRIGGER_ENABLED=0 registers no job, registers no
# WS callback, and makes the tick take no lock (byte-identical runtime);
# CRYPTOBOT_FAST_TRIGGER_EVENT_ENABLED=0 keeps the sweep and drops only the WS
# rung.
# CRYPTOBOT_FAST_TRIGGER_ENABLED=1
# CRYPTOBOT_FAST_TRIGGER_MS=250
# CRYPTOBOT_FAST_TRIGGER_EVENT_ENABLED=1

# Anchored FAK pad (operator-approved 2026-07-11). Lift the executable limit of
# every LIVE sub-minute BUY FAK by this many dollars so it crosses a book that
# ticked up between the score and the sign, WITHOUT chasing a runaway book:
#   padded = min(walked_limit + PAD, first_limit_of_this_side_window + PAD)
# clipped to <= 0.99 (first_limit = the walked_limit of the window's first placed
# attempt, held in-memory on the WindowDecider). Cash stake is unchanged, so a
# higher fill just buys fewer shares. Selection/gates read the OBSERVED ask, never
# the padded limit. Does NOT touch stop-loss SELLs, pair sleeves, or DRY rows.
# Default 0.0 = OFF = byte-identical. Counterfactual over live history: +28.6% PnL.
# CRYPTOBOT_V2_FAK_PAD=0.0

# Fill-rate / realized-EV breaker — DELIBERATELY DISABLED by operator order
# (2026-07-08): v2 is a new strategy and must not be halted by the old
# sub-minute add-on's record. install_remote.sh pins all three so a redeploy
# cannot silently re-arm the breaker. RESET moves the window to the v2 go-live
# instant; MIN_FILL_RATE=0.0 can never trip; EV_MAX_LOSS_FRAC=999 can never
# trip. To restore the guard: delete these + redeploy (see install_remote.sh).
CRYPTOBOT_SUBMINUTE_BREAKER_RESET=2026-07-08T13:45:00Z
CRYPTOBOT_SUBMINUTE_BREAKER_MIN_FILL_RATE=0.0
CRYPTOBOT_SUBMINUTE_BREAKER_EV_MAX_LOSS_FRAC=999

# Emergency stop: checked immediately before EVERY sub-minute placement and
# refuses regardless of every other flag/state. Set to 1 to halt all live
# betting without a redeploy. Default 0.
# CRYPTOBOT_SUBMINUTE_KILL=0

# ─────────────────────────────────────────────────────────────────────────────
# Latency: order-book prefetch + WS book mirror
# ─────────────────────────────────────────────────────────────────────────────

# A8 REST book prefetch-ahead: a daemon re-fetches the previous tick's
# POST /books token set ~150ms before each second boundary; the tick reads those
# snapshots (served only if younger than MAX_AGE_MS) instead of the inline batch
# round-trip. Falls through to the inline fetch on any miss. NOW ARMED (pinned
# true on the box); default is false.
CRYPTOBOT_BOOK_PREFETCH_ENABLED=true
# CRYPTOBOT_BOOK_PREFETCH_LEAD_MS=150
# CRYPTOBOT_BOOK_PREFETCH_MAX_AGE_MS=700

# WS book mirror: mirrors the Polymarket CLOB *market* WebSocket into a snapshot
# cache the tick reads before the inline POST /books batch. Unlike the REST
# prefetch it carries a VENUE timestamp, so book staleness is real. Built and
# shipped but LEFT OFF — arm it AFTER the REST prefetch runs clean, in three
# steps (see install_remote.sh): (1) shadow (ENABLED=1 + SHADOW=1, mirror runs
# but REST stays authoritative; watch divergence >=1 day), (2) authoritative
# (drop SHADOW), (3) kill (ENABLED back off -> falls back to REST). Defaults OFF.
# CRYPTOBOT_BOOK_WS_ENABLED=0
# CRYPTOBOT_BOOK_WS_SHADOW=0
# CRYPTOBOT_BOOK_WS_MAX_AGE_MS=700
# CRYPTOBOT_BOOK_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ─────────────────────────────────────────────────────────────────────────────
# Telegram alerts (uncomment + fill to enable)
# Get a bot token from @BotFather and your numeric chat_id from @userinfobot.
# CRITICAL events also mirror to logs/CRITICAL.log so a Telegram outage
# doesn't swallow the only operator signal.
# ─────────────────────────────────────────────────────────────────────────────
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard
# ─────────────────────────────────────────────────────────────────────────────
CRYPTOBOT_DASHBOARD_USER=admin
CRYPTOBOT_DASHBOARD_PASS=          # set a long random string before binding non-loopback (this is the var auth actually reads)
# Required when binding 0.0.0.0 in production:
# CRYPTOBOT_DASHBOARD_TLS_TERMINATED=1   # confirms a TLS-terminating reverse proxy sits in front

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC APIs (no auth — already wired, no env vars needed)
# ─────────────────────────────────────────────────────────────────────────────
# Binance public market data (live spot):     https://api.binance.com
# Polymarket Gamma (events, markets):         https://gamma-api.polymarket.com
# Polymarket CLOB (book reads, prices):       https://clob.polymarket.com
# Chainlink on-chain Data Feeds:              via Polygon RPC (e.g. polygon-rpc.com)
#
# ─────────────────────────────────────────────────────────────────────────────
# GATED (NOT used — skip unless you want to negotiate with Chainlink)
# ─────────────────────────────────────────────────────────────────────────────
# Chainlink Data Streams (1-min granular):    REST API requires HMAC-signed key,
#                                             obtained by contacting Chainlink BD.
#                                             Not realistic for retail.
