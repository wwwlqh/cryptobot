# Local configuration: copy to .env and fill in (.env is gitignored).
#
# The full list of bot settings, with comments, is in
# polymarket/infra/cryptobot.env.example (the server's /etc/cryptobot.env).
# Anything set there can also be set here for a local run.

# ---- Research data (not needed to run the bot) ------------------------------
# pmdata.dev key, used by the polymarket/backtest/fetch downloaders for order
# book snapshots and Chainlink tapes.
PMDATA_API_KEY=

# ---- Polymarket credentials (only for live orders) --------------------------
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=
POLY_PRIVATE_KEY=
# 3 = Polymarket deposit wallet (set POLY_FUNDER to its address); 0 = plain EOA.
POLY_SIGNATURE_TYPE=3
POLY_FUNDER=
POLY_RETURN_WALLET=
RELAYER_URL=https://relayer-v2.polymarket.com
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLYGON_RPC_URL=https://polygon-rpc.com

# ---- Run settings -----------------------------------------------------------
# New wallets start in DRY (paper) mode.
DRY_RUN=true
CRYPTOBOT_INITIAL_BANKROLL=100
CRYPTOBOT_SUBMINUTE_ENABLED=1
CRYPTOBOT_COINS=BTC,ETH,SOL,XRP
CRYPTOBOT_ENABLE_TOPUPS=0
CRYPTOBOT_V2_BASE_FRAC_15M=0.010
CRYPTOBOT_V2_BASE_FRAC_5M=0.010
CRYPTOBOT_V2_BRAKE_FLOOR=1.0
CRYPTOBOT_SHARED_EXPOSURE_CAP=1.0
CRYPTOBOT_MAX_DD_HALT_FRAC=0.40
CRYPTOBOT_SPOT_USE_1S_KLINES=1

# ---- Dashboard --------------------------------------------------------------
CRYPTOBOT_DASHBOARD_USER=admin
# Use a long random string; for local-only use you can instead set
# CRYPTOBOT_DASHBOARD_AUTH_DISABLED=1 (loopback bind only).
CRYPTOBOT_DASHBOARD_PASS=

# ---- Telegram alerts (optional) ---------------------------------------------
# NOTIFY_TELEGRAM_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
