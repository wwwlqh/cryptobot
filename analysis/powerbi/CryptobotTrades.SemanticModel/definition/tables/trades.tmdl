		dataType: double
		formatString: 0.000
		lineageTag: 628bdf70-b75e-4398-b348-eb7ffb36b1ad
		summarizeBy: none
		sourceColumn: fill_price

	column stake_usd
		dataType: double
		formatString: \$#,0.00
		lineageTag: 2aa3e23d-d40e-48a8-81a0-210d129f2475
		summarizeBy: none
		sourceColumn: stake_usd

	column is_top_up
		dataType: int64
		formatString: 0
		lineageTag: 1639ce0e-7e3a-4aac-a4d1-9944543b1d58
		summarizeBy: none
		sourceColumn: is_top_up

	column outcome
		dataType: string
		lineageTag: 6c4d3010-0283-4c19-b2cd-347e0df5ced0
		summarizeBy: none
		sourceColumn: outcome

	column market_went_up
		dataType: int64
		formatString: 0
		lineageTag: bdd4e6a9-ba05-4db4-adc0-16b9637c3510
		summarizeBy: none
		sourceColumn: market_went_up

	column model_correct
		dataType: int64
		formatString: 0
		lineageTag: 23d9de65-c906-46dd-8437-78e42b217890
		summarizeBy: none
		sourceColumn: model_correct

	column pnl_usd
		dataType: double
		formatString: \$#,0.00;-\$#,0.00
		lineageTag: 51c76326-deba-48e5-aa18-347150360fef
		summarizeBy: none
		sourceColumn: pnl_usd

	column seconds_into_window
		dataType: int64
		formatString: 0
