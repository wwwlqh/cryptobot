		sourceColumn: seconds_into_window

	column cum_pnl_usd
		dataType: double
		formatString: \$#,0.00;-\$#,0.00
		lineageTag: deed0c89-85d1-4cf9-94c1-ae5740cdf31f
		summarizeBy: none
		sourceColumn: cum_pnl_usd

	column drawdown_usd
		dataType: double
		formatString: \$#,0.00;-\$#,0.00
		lineageTag: 559384be-7809-4a27-978a-6b2d2a874f9e
		summarizeBy: none
		sourceColumn: drawdown_usd

	column 'Prob Bucket' = SWITCH ( TRUE (), ISBLANK ( trades[model_prob] ), BLANK (), trades[model_prob] < 0.7, "60-70%", trades[model_prob] < 0.8, "70-80%", trades[model_prob] < 0.9, "80-90%", "90-100%" )
		dataType: string
		lineageTag: 3c964fe9-8a55-4df1-b386-cd422077b889
		summarizeBy: none

	partition trades = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFile), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"trade_id", Int64.Type}, {"bet_time_utc", type datetime}, {"bet_date", type date}, {"bet_hour_utc", Int64.Type}, {"coin", type text}, {"strategy", type text}, {"window", type text}, {"side", type text}, {"model_prob", type number}, {"market_price", type number}, {"model_edge", type number}, {"fill_price", type number}, {"stake_usd", type number}, {"is_top_up", Int64.Type}, {"outcome", type text}, {"market_went_up", Int64.Type}, {"model_correct", Int64.Type}, {"pnl_usd", type number}, {"seconds_into_window", Int64.Type}, {"cum_pnl_usd", type number}, {"drawdown_usd", type number}}, "en-US")
				in
				    Typed

