table trades
	lineageTag: 39e17994-547e-471a-bcb9-0909bf4c0811

	measure Trades = COUNTROWS ( trades )
		formatString: #,0
		lineageTag: ab5c6efe-18d7-46cc-852a-c10d70c9e6bf

	measure 'Resolved Trades' = CALCULATE ( [Trades], trades[outcome] <> "Pending" )
		formatString: #,0
		lineageTag: 26c4cc81-2744-4726-b1d5-a86384886200

	measure 'Net PnL' = SUM ( trades[pnl_usd] )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		lineageTag: 8edb05b9-caa3-4906-a12a-754fc06a63ee

	measure 'Total Staked' = SUM ( trades[stake_usd] )
		formatString: \$#,0
		lineageTag: 88d001df-48c7-4dd1-81ef-fc4862efff70

	measure 'ROI %' = DIVIDE ( [Net PnL], [Total Staked] )
		formatString: 0.00%
		lineageTag: 8c883ca2-e8e1-4ac3-a447-672ccc60734b

	measure 'Win Rate %' = DIVIDE ( CALCULATE ( [Trades], trades[pnl_usd] > 0 ), [Resolved Trades] )
		formatString: 0.0%
		lineageTag: 74312464-8ecf-4122-ae2f-00a037e5cec6

	measure 'Avg Win' = CALCULATE ( AVERAGE ( trades[pnl_usd] ), trades[pnl_usd] > 0 )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		lineageTag: 54071e09-46bb-4d46-b523-f93a28823462

	measure 'Avg Loss' = CALCULATE ( AVERAGE ( trades[pnl_usd] ), trades[pnl_usd] < 0 )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		lineageTag: b1661034-0a15-4a5d-9d80-9afea4b99c9c

	measure 'Model Accuracy %' = CALCULATE ( AVERAGE ( trades[model_correct] ), NOT ISBLANK ( trades[model_prob] ) )
		formatString: 0.0%
		lineageTag: 748f6a17-3b54-4393-8a71-8293bffba085

	measure 'Avg Model Prob %' = AVERAGE ( trades[model_prob] )
		formatString: 0.0%
		lineageTag: 04a126cc-fb93-4c85-8dd4-1e259bc1833a

	measure 'Avg Price Paid %' = CALCULATE ( AVERAGE ( trades[market_price] ), NOT ISBLANK ( trades[model_prob] ) )
		formatString: 0.0%
		lineageTag: daac1c22-838e-4036-a096-f0e2ee07ce0c

	measure 'Accuracy vs Price (pts)' = ( [Model Accuracy %] - [Avg Price Paid %] ) * 100
		formatString: +0.0;-0.0
		lineageTag: 44b62ac9-fdb0-4b22-8e68-0df3579f47b4

	measure 'Cumulative PnL' = VAR _upTo = MAX ( trades[bet_date] ) RETURN CALCULATE ( [Net PnL], trades[bet_date] <= _upTo, REMOVEFILTERS ( trades[bet_date], trades[bet_time_utc], trades[trade_id] ) )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		lineageTag: 09504806-e8c7-4775-9d0d-d86f3658b73b

	measure 'Max Drawdown' = MIN ( trades[drawdown_usd] )
		formatString: \$#,0.00;-\$#,0.00;\$0.00
		lineageTag: 0c32b957-c22e-4517-8a5d-d4880acd96ac

	column trade_id
		dataType: int64
